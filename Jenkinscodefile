pipeline {
    agent any

    stages {

        stage('Disk Usage') {
            steps {
                sh 'df -kh'
            }
        }

        stage('Change Directory') {
            steps {
                sh 'cd /tmp && pwd'
            }
        }

        stage('List Files') {
            steps {
                sh 'ls -lrth /tmp'
            }
        }

        stage('CPU Usage') {
            steps {
                sh 'top -b -n 1'
            }
        }

        stage('Memory Usage') {
            steps {
                sh 'free -h'
            }
        }

        stage('System Load & Uptime') {
            steps {
                sh 'uptime'
            }
        }

        stage('Apache Service Check') {
            steps {
                sh '''
                systemctl is-active httpd || \
                systemctl is-active apache2 || true
                '''

            }
        }
    }
}
